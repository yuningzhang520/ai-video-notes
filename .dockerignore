# Keep the build context (and image) small and free of secrets/junk.
# NOTE: static/frames/*.jpg are intentionally NOT excluded -- they ship in the image.

# Python
venv/
__pycache__/
*.pyc
.pytest_cache/

# Secrets / tokens -- never ship these
.env
.env.*
!.env.example
.take-home-token

# VCS / submission / build artifacts
.git/
.gitignore
dist/

# Node / editor / OS junk
node_modules/
.DS_Store
.Rhistory

# Generated data
data/output/
# Step 3A ingest-probe artifacts (downloaded video + extracted frames) -- never ship these
work/

# Docs and planning files not needed to run the service
APPROACH.md
CLAUDE.md
PLAN.md
README.md
video.md
.claude/
