# Copy to .env and fill in only what you need.
#
# RUNTIME NEEDS NO KEYS. The served app (uvicorn / Docker) reads committed artifacts and never
# calls Anthropic or YouTube — it runs with no .env at all. ANTHROPIC_API_KEY is used ONLY by the
# OPTIONAL build-time rebuild scripts when run with --force
# (scripts/build_visual_blocks.py / scripts/build_full_note.py). See README.md.

# --- Build-time only (optional reruns with --force) ---
ANTHROPIC_API_KEY=sk-ant-xxxxx
# Claude model for build-time vision + structuring. Overrideable; defaults to this if unset.
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Serving (optional) ---
# The app binds $PORT (default 8000). Docker / the host platform may inject this; you rarely set it by hand.
PORT=8000

# --- Unused by this submission; left from the take-home template ---
OPENAI_API_KEY=sk-xxxxx
ELEVEN_LABS_API_KEY=xxxxx
GOOGLE_CLOUD_API_KEY=xxxxx
AWS_ACCESS_KEY_ID=xxxxx
AWS_SECRET_ACCESS_KEY=xxxxx
AWS_REGION=us-west-2
